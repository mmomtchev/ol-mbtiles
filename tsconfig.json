{
  "compilerOptions": {
    "module": "node16",
    "target": "es2020",
    "esModuleInterop": true,
    "moduleResolution": "node16",
    "types": [
      "node",
      "jquery"
    ],
    "sourceMap": true,
    "strict": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "paths": {
      "ol-mbtiles": [
        "."
      ]
    },
  },
  "include": [
    "./src",
    "./examples"
  ],
  "exclude": [
    "node_modules"
  ]
}
